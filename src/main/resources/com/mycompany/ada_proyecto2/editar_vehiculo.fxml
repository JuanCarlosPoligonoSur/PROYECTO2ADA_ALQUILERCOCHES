<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.ada_proyecto2.controller.EditarVehiculoController"
      spacing="20" styleClass="main-panel">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="EDITAR VEHÍCULO" styleClass="label-title"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBusqueda" promptText="VIN o matrícula" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#buscarVehiculo" styleClass="secondary-button"/>
    </HBox>

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="VIN" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtVin" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

        <Label text="Matrícula" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="txtMatricula" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Marca" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMarca" GridPane.rowIndex="3" GridPane.columnIndex="0"/>

        <Label text="Modelo" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <TextField fx:id="txtModelo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Kilometraje actual" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtKilometrajeActual" GridPane.rowIndex="5" GridPane.columnIndex="0"/>

        <Label text="Nuevo kilometraje" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <TextField fx:id="txtNuevoKilometraje" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <Button text="Guardar cambios" onAction="#guardarCambios" styleClass="secondary-button"/>
        <Button text="Volver al menú" onAction="#volverAlMenu" styleClass="secondary-button"/>
    </HBox>
</VBox>
