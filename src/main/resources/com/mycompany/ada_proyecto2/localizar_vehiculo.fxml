<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.ada_proyecto2.controller.LocalizarVehiculoController"
      spacing="20" styleClass="main-panel">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="LOCALIZAR VEHÍCULO" styleClass="label-title"/>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtBusqueda" promptText="VIN o matrícula" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#buscarVehiculo" styleClass="secondary-button"/>
    </HBox>

    <TextArea fx:id="txtResultado" editable="false" prefRowCount="12" wrapText="true" styleClass="info-box"/>

    <Button text="Volver al menú" onAction="#volverAlMenu" styleClass="secondary-button"/>
</VBox>
