<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.ada_proyecto2.controller.ConsultarContratoController"
      spacing="18" styleClass="main-panel">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="CONSULTAR Y EDITAR CONTRATOS" styleClass="label-title"/>

    <TableView fx:id="tablaContratos" prefHeight="260">
        <columns>
            <TableColumn fx:id="colIdContrato" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colDniCliente" text="DNI" prefWidth="100"/>
            <TableColumn fx:id="colNombreCliente" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="colApellidosCliente" text="Apellidos" prefWidth="140"/>
            <TableColumn fx:id="colVin" text="VIN" prefWidth="110"/>
            <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="100"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="120"/>
            <TableColumn fx:id="colModelo" text="Modelo" prefWidth="120"/>
            <TableColumn fx:id="colFechaRecogida" text="Recogida" prefWidth="170"/>
            <TableColumn fx:id="colFechaEntrega" text="Entrega" prefWidth="170"/>
            <TableColumn fx:id="colFirma" text="Firma" prefWidth="170"/>
        </columns>
    </TableView>

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
            <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID del contrato" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIdContrato" GridPane.rowIndex="1" GridPane.columnIndex="0"/>

        <Label text="DNI del cliente" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="txtDniCliente" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="VIN del vehículo" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtVin" GridPane.rowIndex="3" GridPane.columnIndex="0"/>

        <Label text="Fecha recogida" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <TextField fx:id="txtFechaRecogida" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Fecha entrega" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFechaEntrega" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    </GridPane>

    <HBox spacing="16" alignment="CENTER">
        <Button text="Guardar cambios" onAction="#guardarCambios" styleClass="secondary-button"/>
        <Button text="Buscar contrato" onAction="#buscarContrato" styleClass="secondary-button"/>
        <Button text="Volver al menú" onAction="#volverAlMenu" styleClass="secondary-button"/>
    </HBox>
    <HBox spacing="16" alignment="CENTER">
        <Button text="Firmar contrato" onAction="#firmarContrato" styleClass="secondary-button"/>
        <Button text="Borrar contrato" onAction="#borrarContrato" styleClass="secondary-button"/>
    </HBox>
</VBox>
